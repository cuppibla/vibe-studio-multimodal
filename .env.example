# ── pick ONE auth path ──────────────────────────────────────────────
# A · Cloud Shell / Vertex via ADC (no keys — the codelab default):
STUDIO_VERTEX=1

# B · laptop / AI Studio key (comment A, uncomment B):
# GOOGLE_API_KEY=AIza…your-key…

# ── publishing (the Vibe Studio app, step 9) ─────────────────────────
# The app posts finished clips to the event on vibetube.dev. Both values can
# also be typed into the app's profile drawer; the drawer wins.
# VIBETUBE_URL=https://vibetube.dev
# VIBETUBE_EVENT=your-event-code
# VIBETUBE_NAME=Your Name
# One video per project and room on the platform, and the project is this Google
# Cloud project: publishing again replaces the video. Defaults to
# GOOGLE_CLOUD_PROJECT; set it only to publish under a different id.
# VIBETUBE_PROJECT=your-google-cloud-project-id

# ── knobs you rarely touch ──────────────────────────────────────────
# STUDIO_REAL_VIDEO=0             # no Veo, no cost: a stand-in render that finishes in five seconds
# STUDIO_VEO_MODEL=veo-3.1-fast-generate-001   # Vertex name; AI Studio calls it veo-3.1-fast-generate-preview
# STUDIO_VEO_LOCATION=us-central1   # Veo is regional (Gemini uses the global endpoint)
# STUDIO_VIDEO_RETRIES=8          # attempts per Veo call
# STUDIO_VIDEO_INTERVAL=70        # seconds between attempts
# STUDIO_MODEL=gemini-3-flash-preview
# STUDIO_MEMORY_BANK=projects/…/reasoningEngines/…   # set by deploy.sh on Cloud Run; locally runs/memorybank.json
# STUDIO_RAG_CORPUS=projects/…/ragCorpora/…           # same, for the corpus
# STUDIO_IMAGE_MODEL=gemini-2.5-flash-image            # the avatar model
